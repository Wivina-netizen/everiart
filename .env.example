# Cloudflare R2 — video hosting for the project reels.
#
# Copy to .env and fill in. .env is gitignored; this example file is not, so
# never put real values here.
#
#   cp .env.example .env
#   node upload_r2.mjs           # upload, then verify each public URL
#   node upload_r2.mjs --write   # repoint projects.json at R2

# R2 → Overview → "Account ID" in the right-hand sidebar.
# This is the account id, NOT the bucket name and NOT the token id.
R2_ACCOUNT_ID=

# R2 → Manage R2 API Tokens → Create API Token → Object Read & Write.
# The secret is shown exactly once, on the screen right after you create it.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket you created.
R2_BUCKET=everiart-video

# Public base URL, no trailing slash. Either:
#   the r2.dev development URL   https://pub-<hash>.r2.dev
#   or a custom domain           https://video.everiart.com
# Objects are addressed as <base>/<slug>/reel.mp4
R2_PUBLIC_BASE=
