# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
netlify.toml.local

# Camera masters / source media (~45 GB). Never committed — assets/ holds the
# web-ready derivatives, regenerated from here by make_media.mjs.
media source/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Dependencies / build output
node_modules/
dist/
.netlify/
.cache/

# Python (placeholder generator only)
__pycache__/
*.pyc

# Derived video lives on external hosting (Cloudflare R2), never in the repo.
# Regenerate locally with: node make_media.mjs
assets/**/*.mp4

# A stale duplicate of .claude/skills — an older copy of the pattern library
# that still describes retired patterns (hover-to-play tiles, ambient drift,
# the arrow handover registry) as current. .claude/skills is the tracked one.
.agents/
